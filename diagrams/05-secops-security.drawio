<mxfile host="app.diagrams.net">
  <diagram id="secops" name="SecOps - Defence in depth and trust boundaries">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;SecOps view - layers of control (outside -&gt; in)&lt;/b&gt;" style="text;html=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="L1" value="&lt;b&gt;L1 Edge&lt;/b&gt; - Cloud Armor: OWASP CRS (sqli, xss, lfi, rfi, rce, scanners, protocol, session), 600 req/min/IP throttle, Adaptive Protection (L7 DDoS ML), verbose logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L2" value="&lt;b&gt;L2 Network&lt;/b&gt; - private nodes (no public IP) | control plane via IAM-authorised DNS endpoint | VPC firewall: logged deny-all, allow only LB/HC ranges, IAP SSH, internal | Cloud NAT egress | data tier private IP only (PSA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L3" value="&lt;b&gt;L3 Cluster&lt;/b&gt; - Dataplane V2 NetworkPolicy default-deny per namespace | Pod Security Admission &lt;i&gt;restricted&lt;/i&gt; | Shielded nodes + secure boot | GKE metadata server (node SA hidden) | security posture + vuln scanning | auto-upgrade release channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L4" value="&lt;b&gt;L4 Workload&lt;/b&gt; - non-root UID 10001, read-only root FS, drop ALL caps, seccomp RuntimeDefault, no SA token automount | Managed Service Mesh Envoy sidecars | Workload Identity: KSA app1 -&gt; GSA wl-app1 (no keys) | Secret Manager per-secret IAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L5" value="&lt;b&gt;L5 Supply chain&lt;/b&gt; - immutable SHA tags in primary + recovery Artifact Registry | block CRITICAL scan findings | KMS-backed digest attestation | Binary Authorization enforced on both clusters | deploy by digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L6" value="&lt;b&gt;L6 Identity &amp;amp; audit&lt;/b&gt; - WIF for CI validates repository/owner IDs, main, prod environment and push/manual events; PRs get no cloud credentials | least-privilege node SA | Cloud Audit Logs -&gt; BigQuery | budget alerts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="ci" value="GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="wif" value="WIF pool github&lt;br&gt;exact repo + owner IDs&lt;br&gt;main + prod; push/manual only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="260" y="470" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="sa" value="ci-apps SA" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="kms" value="KMS key build-attestor&lt;br&gt;(EC P-256, signerVerifier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="att" value="Attestation on image digest" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="480" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="gke" value="GKE admission:&lt;br&gt;Binary Authorization&lt;br&gt;allow / block + audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1060" y="580" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="pod" value="pod (KSA app2)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="md" value="GKE metadata server" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="680" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="gsa" value="GSA wl-app2&lt;br&gt;short-lived token" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="680" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="sm" value="Secret Manager&lt;br&gt;app2-api-key (us-central1 + us-east1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="700" y="675" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="OIDC" style="endArrow=classic;html=1;" edge="1" parent="1" source="ci" target="wif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="impersonate" style="endArrow=classic;html=1;" edge="1" parent="1" source="wif" target="sa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="sign" style="endArrow=classic;html=1;" edge="1" parent="1" source="sa" target="kms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="kms" target="att"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="verify" style="endArrow=classic;html=1;" edge="1" parent="1" source="att" target="gke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="pod" target="md"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="workloadIdentityUser" style="endArrow=classic;html=1;" edge="1" parent="1" source="md" target="gsa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="secretAccessor (this secret only)" style="endArrow=classic;html=1;" edge="1" parent="1" source="gsa" target="sm"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
