<mxfile host="app.diagrams.net">
  <diagram id="techlead" name="Tech Lead - Code structure and module dependencies">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Tech Lead view - Terraform stacks, module graph, standards&lt;/b&gt;" style="text;html=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="boot" value="&lt;b&gt;terraform/bootstrap&lt;/b&gt; (local state, run once by a human)&lt;br&gt;project | APIs | tfstate bucket | WIF pool | ci-terraform SA | ci-apps SA | budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="prod" value="&lt;b&gt;terraform/envs/prod&lt;/b&gt; (GCS remote state, run by CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="net" value="modules/network" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="sec" value="modules/security" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="230" y="280" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="reg" value="modules/registry" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="obs" value="modules/observability" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="280" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="gke" value="modules/gke (for_each: usc1, use1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="140" y="380" width="260" height="40" as="geometry"/></mxCell>
        <mxCell id="data" value="modules/data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="fleet" value="modules/fleet (MCS + MCI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="d1" style="endArrow=classic;html=1;" edge="1" parent="1" source="net" target="gke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" value="BinAuthz policy first" style="endArrow=classic;html=1;" edge="1" parent="1" source="sec" target="gke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3" value="usage dataset" style="endArrow=classic;html=1;" edge="1" parent="1" source="obs" target="gke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4" value="PSA peering" style="endArrow=classic;html=1;" edge="1" parent="1" source="net" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d5" value="app GSAs" style="endArrow=classic;html=1;" edge="1" parent="1" source="sec" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d6" value="config membership" style="endArrow=classic;html=1;" edge="1" parent="1" source="gke" target="fleet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d7" style="endArrow=classic;html=1;" edge="1" parent="1" source="boot" target="prod"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d8" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="prod" target="net"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="std" value="&lt;b&gt;Standards&lt;/b&gt;&lt;br&gt;- provider pinned ~&gt; 6.40, lock file committed&lt;br&gt;- terraform fmt + tflint + checkov must pass on every PR&lt;br&gt;- no *.tfvars / state / keys in git&lt;br&gt;- every skip in .checkov.yaml has a written reason&lt;br&gt;- one module = one responsibility, outputs instead of data lookups&lt;br&gt;- naming: &amp;lt;component&amp;gt;-&amp;lt;region-key&amp;gt; (gke-usc1)&lt;br&gt;- decisions recorded as ADRs in docs/techlead/adr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="520" height="200" as="geometry"/></mxCell>
        <mxCell id="repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;apps/ (app1, app2, common, Dockerfile)&lt;br&gt;k8s/base/app1, k8s/base/app2 (every cluster)&lt;br&gt;k8s/gateway (config cluster only)&lt;br&gt;scripts/deploy.sh&lt;br&gt;grafana/ (dashboard + SQL)&lt;br&gt;.github/workflows (terraform.yml, apps.yml)&lt;br&gt;docs/ (one folder per role) | diagrams/" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="520" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
