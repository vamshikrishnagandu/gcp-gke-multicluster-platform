<mxfile host="app.diagrams.net">
  <diagram id="devops" name="DevOps - CI/CD pipelines">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;DevOps view - keyless CI/CD with GitHub Actions&lt;/b&gt;" style="text;html=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="dev" value="Developer&lt;br&gt;PR -&gt; main" style="shape=mxgraph.basic.person;fillColor=#dae8fc;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="40" height="50" as="geometry"/></mxCell>
        <mxCell id="gh" value="GitHub repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="140" y="110" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="oidc" value="GitHub OIDC token&lt;br&gt;-&gt; STS -&gt; WIF pool &lt;i&gt;github&lt;/i&gt;&lt;br&gt;repo/owner IDs; main + prod; push/manual only&lt;br&gt;-&gt; impersonate SA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="tf" value="terraform.yml" style="swimlane;horizontal=0;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1150" height="110" as="geometry"/></mxCell>
        <mxCell id="tf1" value="fmt -check" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tf"><mxGeometry x="40" y="30" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="tf2" value="tflint" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tf"><mxGeometry x="170" y="30" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="tf3" value="checkov" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tf"><mxGeometry x="300" y="30" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="tf4" value="auth (ci-terraform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="tf"><mxGeometry x="430" y="30" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="tf5" value="init + validate + plan&lt;br&gt;required inputs; no deletions" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tf"><mxGeometry x="580" y="30" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="tf6" value="PR: comment plan" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tf"><mxGeometry x="750" y="30" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="tf7" value="main: apply&lt;br&gt;(env prod approval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="tf"><mxGeometry x="910" y="30" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="ap" value="apps.yml" style="swimlane;horizontal=0;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="1150" height="110" as="geometry"/></mxCell>
        <mxCell id="ap1" value="Ruff + app smoke tests&lt;br&gt;Helm lint + render" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ap"><mxGeometry x="40" y="30" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="ap2" value="auth (ci-apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="ap"><mxGeometry x="190" y="30" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="ap3" value="docker build + push&lt;br&gt;immutable SHA; primary + recovery registries" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ap"><mxGeometry x="320" y="30" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="ap4" value="vuln scan&lt;br&gt;block CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="ap"><mxGeometry x="500" y="30" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="ap5" value="KMS sign attestation&lt;br&gt;(Binary Authorization)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="ap"><mxGeometry x="640" y="30" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="ap6" value="Helm deploy by DIGEST&lt;br&gt;both clusters; MCS-derived app2 URL&lt;br&gt;Gateway on config cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="ap"><mxGeometry x="810" y="25" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="ap7" value="rollout status&lt;br&gt;(maxUnavailable 0)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ap"><mxGeometry x="1000" y="30" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="dev" target="gh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="terraform/**" style="endArrow=classic;html=1;" edge="1" parent="1" source="gh" target="tf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="apps/** charts/** scripts/**" style="endArrow=classic;html=1;" edge="1" parent="1" source="gh" target="ap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;b&gt;No long-lived CI credentials in GitHub.&lt;/b&gt; Variables: GCP project/WIF/service accounts, state bucket, GATEWAY_IP, BINAUTHZ_MODE. Encrypted secret: ALERT_EMAIL. PRs run static checks only; production jobs require main + prod environment." style="text;html=1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1400" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
